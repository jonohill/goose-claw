+/// Whether the adversary reviewer should fail OPEN (allow the tool call) when it
+/// cannot produce a verdict — i.e. no provider is available or the review call
+/// errored.
+///
+/// Upstream behaviour is fail-open. This build defaults to fail-CLOSED so a
+/// provider outage or review error blocks the reviewed tool instead of silently
+/// letting it through. Set `GOOSE_ADVERSARY_FAIL_CLOSED` to a falsey value
+/// (`0`, `false`, `no`, `off`) to restore the upstream fail-open behaviour
+/// without rebuilding.
+fn adversary_fails_open() -> bool {
+    std::env::var("GOOSE_ADVERSARY_FAIL_CLOSED")
+        .ok()
+        .map(|v| {
+            matches!(
+                v.trim().to_ascii_lowercase().as_str(),
+                "0" | "false" | "no" | "off"
+            )
+        })
+        .unwrap_or(false)
+}
+
+/// Outcome of an adversary review of a single tool call.
+enum ReviewOutcome {
+    /// The reviewer explicitly allowed the call.
+    Allow(String),
+    /// The reviewer explicitly blocked the call — a real detection. Always a
+    /// hard Deny; never downgraded regardless of mode or the fail-open setting.
+    Block(String),
+    /// The reviewer could not render a verdict (no provider available, or the
+    /// review call errored). Subject to the fail-open / fail-closed policy.
+    Unavailable(String),
+}
